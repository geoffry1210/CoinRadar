# CoinRadar Bot — Environment Variables
# Copy this to .env and fill in your values

TELEGRAM_BOT_TOKEN=       # From @BotFather
MY_CHAT_ID=               # Your personal Telegram user ID (admin)
DATABASE_URL=             # PostgreSQL connection string (Railway provides this)

COINGECKO_API_KEY=        # CoinGecko demo key (free at coingecko.com/api)
ETHERSCAN_API_KEY=        # Etherscan API key (also used for BscScan)
HELIUS_API_KEY=           # Helius RPC key for Solana (helius.dev)
MORALIS_API_KEY=          # Moralis key — fallback for ETH/BSC top holders (moralis.io)
